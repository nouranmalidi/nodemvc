<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Enregistrement</title>
</head>
<body>
   <%- include('navbar') %> 

<h2>Enregistrement</h2>

<form action="/register" method="POST">
    <div class="container"> 
        <h3>S'enregistrer</h3>
        <p>Veuillez remplir ce formulaire pour créer un compte.</p>
        <hr> <!-- Pour Tracer une ligne horizontale -->
       <!-- Zone de saisie email -->
        <label for="email"><b>Email</b></label>
        <input type="email" placeholder="Entrer votre email" name="email" required id="email">
       <!-- Zone saisie mot de passe -->
        <label for="psw"><b>Mot de passe</b></label>
        <input type="password" placeholder="Entrer votre mot de passe" name="psw" required id="psw"> 

        <button type="submit" class="registerbtn">S'enregistrer</button>
    </div>
        
</form>


</body>
</html>